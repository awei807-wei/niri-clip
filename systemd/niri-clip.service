[Unit]
Description=niri-clip Wayland clipboard history overlay
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/niri-clip daemon
Restart=on-failure
RestartSec=1s
UMask=0077
NoNewPrivileges=yes
LockPersonality=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=graphical-session.target
